{
  "name": "turtle-tracer",
  "private": true,
  "version": "2.6.0",
  "author": "Matthew Allen <FTCTurtleTracer@gmail.com>",
  "email": "FTCTurtleTracer@gmail.com",
  "license": "Modified Apache 2.0",
  "description": "A better alternative to the Pedro Pathing Visualizer",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:types && npm run fix:headers && npm run format && npm run fix:notice && tauri dev",
    "start": "tauri dev",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "preview": "vite preview",
    "build": "npm run generate:types && npm run generate:icons && npm run copy:icon && vite build",
    "check": "npm run generate:types && npm run generate:icons && npm run check:tiles && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.svelte",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:duplication": "node scripts/duplication-report.js",
    "coverage": "vitest run --coverage && npm run badges:coverage",
    "lighthouse": "npm run build && start-server-and-test preview http://localhost:4173 'node scripts/update-lighthouse-readme-badges.js --url http://localhost:4173'",
    "dist:publish": "node scripts/publish.js",
    "generate:types": "node scripts/generate-plugin-types.js",
    "generate:icons": "node scripts/generate-windows-icons.cjs",
    "docs:examples": "vite-node scripts/generate-doc-examples.ts --",
    "check:tiles": "node scripts/check-tile-assets.cjs",
    "copy:icon": "node scripts/prepare-mac-icon.js",
    "fix:headers": "node scripts/add-copyright.js",
    "fix:notice": "node scripts/generate-file-notice.js",
    "badges:coverage": "node scripts/update-coverage-badge.js",
    "release": "npm run coverage && node scripts/bump-version.js && npm run lighthouse",
    "version:bump": "npm run release",
    "playwright": "playwright"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "4.0.4",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/jsdom": "28.0.0",
    "@types/markdown-it": "14.1.2",
    "@types/upng-js": "2.1.5",
    "@typescript-eslint/eslint-plugin": "8.58.0",
    "@typescript-eslint/parser": "8.58.0",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "10.4.27",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-svelte": "2.46.1",
    "eslint-plugin-unicorn": "56.0.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.5.3",
    "hotkeys-js": "3.13.15",
    "jscpd": "4.0.8",
    "jsdom": "28.1.0",
    "postcss": "8.5.13",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.5.1",
    "sharp": "0.34.5",
    "start-server-and-test": "3.0.0",
    "svelte": "5.55.9",
    "svelte-check": "4.4.6",
    "svelte-eslint-parser": "0.42.0",
    "tailwindcss": "3.4.19",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@types/d3": "7.4.3",
    "@types/lodash": "4.17.24",
    "canvas": "3.2.1",
    "d3": "7.9.0",
    "diff": "8.0.3",
    "dompurify": "3.4.11",
    "driver.js": "1.4.0",
    "gif.js": "0.2.0",
    "highlight.js": "11.11.1",
    "html2pdf.js": "0.14.0",
    "java-parser": "3.0.1",
    "lodash": "4.18.1",
    "markdown-it": "14.2.0",
    "prettier-plugin-java": "2.9.4",
    "sass": "1.97.3",
    "svelte-highlight": "7.9.0",
    "two.js": "0.8.23",
    "typescript": "5.9.3",
    "upng-js": "2.1.0"
  },
  "overrides": {
    "lodash-es": "4.17.23",
    "esbuild": "^0.25.0"
  }
}
