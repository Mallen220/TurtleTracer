<!-- Lets the desktop open .turt and .pp files with Turtle Tracer. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-turtle-tracer">
    <comment>Turtle Tracer Project</comment>
    <glob pattern="*.turt"/>
  </mime-type>
  <mime-type type="application/x-turtle-tracer-legacy">
    <comment>Turtle Tracer Project (Legacy .pp)</comment>
    <glob pattern="*.pp"/>
  </mime-type>
</mime-info>
